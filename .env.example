# Copy to .env and edit. Every value here is the default, so an empty .env
# behaves identically -- uncomment only what you want to change.
#
#   cp .env.example .env

# --------------------------------------------------------------------------- #
# App
# --------------------------------------------------------------------------- #
APP_ENV=dev                       # dev | prod | test
LOG_LEVEL=INFO                    # CRITICAL | ERROR | WARNING | INFO | DEBUG

# Comma-separated allowed origins. The bundled frontend is served from the same
# origin, so "*" is only relevant if you point a separate frontend at this API.
# Note: credentials are only allowed when you name explicit origins, never "*".
CORS_ORIGINS=*

# Leave unset and the API is open -- the right default for a local single-user
# tool. Set it and every route except /health requires `X-API-Key: <value>`
# (or `Authorization: Bearer <value>`). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# --------------------------------------------------------------------------- #
# Providers
# --------------------------------------------------------------------------- #
# "ollama" for real local inference; "fake" for deterministic offline runs with
# no daemon and no model downloads (used by the test suite, and useful for
# frontend work or a quick demo on a machine with nothing pulled); "openai" for
# any hosted service speaking the OpenAI API shape, which is what a deployed
# copy uses since there is no Ollama in the container.
#
# The two are independent: several cheap inference hosts serve chat models but
# no embedding model, so pointing LLM_PROVIDER at one and EMBEDDING_PROVIDER at
# another is a normal configuration.
EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1

# Must match your embedding model's output width. nomic-embed-text is 768.
# Changing the model means re-ingesting: vectors of different widths cannot be
# compared, and mixing them silently corrupts retrieval.
EMBEDDING_DIM=768

REQUEST_TIMEOUT=120               # seconds, generation
EMBED_TIMEOUT=300                 # seconds, batch embedding (slower on CPU)

# --------------------------------------------------------------------------- #
# Hosted inference (only read when a provider above is "openai")
# --------------------------------------------------------------------------- #
# Never commit a real key. Locally this belongs in .env, which is gitignored;
# when deployed, set it through your platform's secret store instead:
#   fly secrets set OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Only needed to split generation and embeddings across two hosts. Both fall
# back to the values above when unset.
# OPENAI_EMBED_BASE_URL=
# OPENAI_EMBED_API_KEY=

# Ask the API to shorten its vectors, for providers that support it. Leave unset
# to take the model's native width. If you set this, EMBEDDING_DIM must match it.
# OPENAI_EMBED_DIMENSIONS=

# A working hosted pairing, for reference. text-embedding-3-small returns 1536
# numbers per chunk, not the 768 that nomic-embed-text produces -- so switching
# to it means re-ingesting everything, and EMBEDDING_DIM must change with it:
#   EMBEDDING_PROVIDER=openai
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIM=1536

# --------------------------------------------------------------------------- #
# Multi-visitor isolation
# --------------------------------------------------------------------------- #
# Off by default, which is right for a local single-user tool: everything is
# filed under one shared owner and the app behaves as it always has.
#
# Turn it on for any deployment more than one person can reach. Each browser is
# issued an HttpOnly cookie and gets its own private library -- documents,
# sessions, history, and both halves of hybrid retrieval are all scoped to it.
# Leaving this off behind a public link means every visitor shares one document
# set and can read and delete each other's uploads.
VISITOR_ISOLATION=false
VISITOR_COOKIE_NAME=qa_visitor
VISITOR_COOKIE_DAYS=180

# The owner value used when isolation is off, and the one existing documents are
# backfilled to when you upgrade. Changing it orphans the library.
SHARED_OWNER=shared

# Documents one visitor may hold. 0 means unlimited, which is the sensible local
# default and a poor one on a public link -- it bounds disk use and embedding
# spend both. Exceeding it returns HTTP 429 before the upload is read.
MAX_DOCUMENTS_PER_VISITOR=0

# --------------------------------------------------------------------------- #
# Chunking
# --------------------------------------------------------------------------- #
# Characters, not tokens (~4 chars per token). 1200/200 suits prose documents.
# Larger chunks give the model more context per source but blunt retrieval
# precision; smaller chunks retrieve sharply but can cut a fact from the
# sentence that qualifies it.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200                 # must be < CHUNK_SIZE
MIN_CHUNK_CHARS=50                # drops page numbers and running headers

# --------------------------------------------------------------------------- #
# Ingestion
# --------------------------------------------------------------------------- #
MAX_UPLOAD_MB=50
EMBED_BATCH_SIZE=16               # chunks per embedding request
INGEST_WORKERS=2                  # concurrent background ingestions

# --------------------------------------------------------------------------- #
# Retrieval
# --------------------------------------------------------------------------- #
TOP_K=5                           # chunks placed in the prompt
CANDIDATE_K=20                    # wider net before fusion/rerank; must be >= TOP_K

HYBRID_SEARCH=true                # vector + SQLite FTS5 keyword, fused by RRF
VECTOR_WEIGHT=0.7                 # 1.0 = vector only, 0.0 = keyword only

RERANK_STRATEGY=mmr               # none | mmr | cross_encoder
MMR_LAMBDA=0.7                    # 1.0 = pure relevance, 0.0 = pure diversity
# cross_encoder needs requirements-optional.txt (pulls torch, ~2 GB)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Cosine-distance ceiling. Chunks further away are treated as irrelevant, which
# is what lets /query answer "I don't know" instead of guessing. Raise it if
# good answers are being refused; lower it if unrelated passages get cited.
MAX_DISTANCE=1.15

# --------------------------------------------------------------------------- #
# Generation
# --------------------------------------------------------------------------- #
LLM_TEMPERATURE=0.1               # low on purpose: this is extraction, not prose
LLM_MAX_TOKENS=1024
MAX_CONTEXT_CHARS=12000           # hard cap so a big TOP_K can't overflow context

# --------------------------------------------------------------------------- #
# OCR for scanned PDFs (optional)
# --------------------------------------------------------------------------- #
# Needs requirements-optional.txt plus system binaries:
#   Debian/Ubuntu: sudo apt-get install tesseract-ocr poppler-utils
#   macOS:         brew install tesseract poppler
OCR_ENABLED=false
OCR_MIN_CHARS_PER_PAGE=100        # below this, a page is assumed to be a scan
OCR_LANGUAGE=eng
OCR_DPI=200

# --------------------------------------------------------------------------- #
# Storage paths (absolute, or relative to the project root)
# --------------------------------------------------------------------------- #
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# CHROMA_DIR=./data/chroma
# SQLITE_PATH=./data/metadata.db
